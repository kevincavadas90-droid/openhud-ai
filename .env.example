# OpenHUD configuration. Copy to .env and adjust. Never commit real secrets.

# Password that protects the whole web app (required in public deployments).
OPENHUD_PASSWORD=troque-esta-senha

# Stable signing secret for session cookies (generate: python -c "import secrets;print(secrets.token_urlsafe(48))").
OPENHUD_SESSION_SECRET=

# Set to "off" only for a fully private/local instance with no login.
OPENHUD_AUTH=on

# Port (OPENHUD_PORT wins; platforms usually inject PORT).
OPENHUD_PORT=8000

# Where SQLite, encrypted keys and the workspace live.
OPENHUD_DATA_DIR=./data
OPENHUD_WORKSPACE=./workspace

# Optional PostgreSQL URL (Neon/Supabase/Aiven free tier). Empty = use SQLite.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Optional default provider. With no key at all, OpenHUD uses the keyless
# Pollinations endpoint and falls back to a local Ollama model if present.
# Add a key for a stronger free tier: Groq, Google AI Studio, OpenRouter, etc.
# OPENHUD_PROVIDER=pollinations
