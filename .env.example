# OpenHUD AI — configuration. Copy to .env and adjust. Never commit real secrets.

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------
# Operator password that protects the whole web app (required in public
# deployments). Generate: python -c "import secrets;print(secrets.token_urlsafe(24))"
OPENHUD_PASSWORD=troque-esta-senha

# Stable signing secret for operator session cookies.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
OPENHUD_SESSION_SECRET=

# "on" (default) requires a session; "off" only for a private/local instance.
OPENHUD_AUTH=on

# User accounts (register/login). "on" by default; "off" disables /register etc.
OPENHUD_ACCOUNTS=on

# ---------------------------------------------------------------------------
# Server / paths
# ---------------------------------------------------------------------------
# OPENHUD_PORT wins; hosting platforms usually inject PORT instead.
OPENHUD_PORT=8000
OPENHUD_HOST=0.0.0.0

# Where SQLite, encrypted keys and the workspace live.
OPENHUD_DATA_DIR=./data
OPENHUD_WORKSPACE=./workspace

# Public base URL (no trailing slash). Used for SEO/canonical links, sitemap
# and the verification / password-reset e-mails. Set this in production.
OPENHUD_PUBLIC_URL=

# Comma-separated CORS allow-list. Empty = disabled (same-origin UI needs none).
OPENHUD_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Optional PostgreSQL URL (Neon/Supabase/Aiven/Railway free tier). Empty = SQLite.
# OPENHUD_DATABASE_URL wins over the generic DATABASE_URL injected by platforms.
# OPENHUD_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ---------------------------------------------------------------------------
# AI provider (optional — with no key, OpenHUD uses the keyless endpoint)
# ---------------------------------------------------------------------------
# OPENHUD_PROVIDER=pollinations
# GROQ_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Distribution (never invent these — leave empty until the real value exists)
# ---------------------------------------------------------------------------
# Real installer URL (GitHub Releases or a CDN).
OPENHUD_DOWNLOAD_URL=
# Donation link shown on /pricing.
OPENHUD_DONATION_URL=
# Serve the locally-built installer / source ZIP from this server (VPS only).
OPENHUD_SERVE_INSTALLER=
OPENHUD_SERVE_SOURCE=

# ---------------------------------------------------------------------------
# E-mail (verification + password reset). Optional; without it, links are only
# logged and the API reports email_sent=false (it never claims to have sent).
# ---------------------------------------------------------------------------
OPENHUD_SMTP_HOST=
OPENHUD_SMTP_PORT=587
OPENHUD_SMTP_USER=
OPENHUD_SMTP_PASSWORD=
OPENHUD_SMTP_FROM=
# "starttls" (587, default), "ssl" (465) or "none" (plain, dev only).
OPENHUD_SMTP_TLS=starttls
# Expose the reset link in the API response when mail could not be sent.
# Only for local testing — leave empty in production.
OPENHUD_EXPOSE_RESET_LINK=
